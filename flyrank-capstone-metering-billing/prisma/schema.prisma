generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id               String            @id @default(uuid())
  name             String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  subscriptions    Subscription[]
  usageEvents      UsageEvent[]
}

model Plan {
  id               String            @id @default(uuid())
  name             String            @unique // 'Free' or 'Pro'
  apiLimit         Int
  tokenLimit       Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  subscriptions    Subscription[]
}

model Subscription {
  id                  String       @id @default(uuid())
  tenantId            String
  planId              String
  stripeCustomerId    String?      @unique
  stripeSubscriptionId String?     @unique
  status              String       @default("active") // active, past_due, canceled
  currentPeriodStart  DateTime     @default(now())
  currentPeriodEnd    DateTime     @default(now())
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  tenant              Tenant       @relation(fields: [tenantId], references: [id])
  plan                Plan         @relation(fields: [planId], references: [id])

  @@unique([tenantId]) // A tenant has one active subscription for simplicity
}

model UsageEvent {
  id               String   @id @default(uuid())
  tenantId         String
  idempotencyKey   String
  type             String   // 'api_call' or 'ai_token'
  quantity         Int
  metadata         Json?    // E.g., { input: 100, cachedInput: 50, output: 200, reasoning: 50 }
  timestamp        DateTime @default(now())

  tenant           Tenant   @relation(fields: [tenantId], references: [id])

  // Prevent double-counting
  @@unique([tenantId, idempotencyKey])
}
